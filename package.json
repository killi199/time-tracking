{
    "name": "time-tracking",
    "version": "1.6.0",
    "versionCode": 25,
    "main": "expo-router/entry",
    "scripts": {
        "start": "expo start",
        "android": "cross-env EXPO_PUBLIC_FOSS_BUILD=false expo run:android --variant=debug",
        "android:foss": "cross-env EXPO_PUBLIC_FOSS_BUILD=true expo run:android --variant=debug",
        "android:release": "cross-env EXPO_PUBLIC_FOSS_BUILD=false expo run:android --variant=release",
        "android:release-foss": "cross-env EXPO_PUBLIC_FOSS_BUILD=true expo run:android --variant=release",
        "build": "cross-env EXPO_PUBLIC_FOSS_BUILD=false expo export",
        "build:foss": "cross-env EXPO_PUBLIC_FOSS_BUILD=true expo export",
        "typecheck": "tsc --noEmit",
        "typecheck:foss": "tsc -p tsconfig.foss.json --noEmit",
        "lint": "eslint --max-warnings 0 .",
        "format": "prettier --write .",
        "test": "jest",
        "generate-licenses": "yarn dlx license-checker-rseidelsohn --production --json --out src/licenses.json"
    },
    "expo": {
        "autolinking": {
            "android": {
                "buildFromSource": [
                    ".*"
                ]
            }
        }
    },
    "dependencies": {
        "@expo/ui": "~58.0.30",
        "@maplibre/maplibre-react-native": "11.5.1",
        "@react-native-community/slider": "5.2.1",
        "@react-native-vector-icons/material-design-icons": "^14.0.0",
        "@react-native/metro-config": "0.88.1",
        "date-fns": "4.4.0",
        "date-fns-jalali": "4.4.0-2",
        "expo": "~58.1.0",
        "expo-build-properties": "~58.0.12",
        "expo-constants": "~58.0.16",
        "expo-document-picker": "~58.0.5",
        "expo-file-system": "~58.0.14",
        "expo-linking": "~58.0.17",
        "expo-localization": "~58.0.5",
        "expo-location": "~58.0.23",
        "expo-notifications": "~58.1.10",
        "expo-quick-actions": "6.0.1",
        "expo-router": "~58.0.33",
        "expo-sharing": "~58.0.24",
        "expo-splash-screen": "~58.0.15",
        "expo-sqlite": "~58.0.18",
        "expo-status-bar": "~58.0.5",
        "expo-system-ui": "~58.0.7",
        "expo-task-manager": "~58.0.14",
        "i18next": "27.2.7",
        "papaparse": "5.7.1",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-i18next": "18.0.3",
        "react-native": "0.88.1",
        "react-native-gesture-handler": "~3.3.0",
        "react-native-nfc-manager": "4.3.0",
        "react-native-paper": "5.15.5",
        "react-native-reanimated": "4.7.1",
        "react-native-restart": "0.0.29",
        "react-native-safe-area-context": "~5.11.1",
        "react-native-screens": "~4.30.1",
        "react-native-web": "0.21.4",
        "react-native-worklets": "0.13.0"
    },
    "jest": {
        "preset": "jest-expo",
        "roots": [
            "<rootDir>/src"
        ],
        "setupFilesAfterEnv": [
            "<rootDir>/src/test/jestSetup.ts"
        ],
        "collectCoverageFrom": [
            "src/**/*.{ts,tsx}",
            "!src/**/*.test.{ts,tsx}",
            "!src/**/*.d.ts",
            "!src/i18n/locales/*.ts",
            "!src/test/**"
        ]
    },
    "jest-junit": {
        "outputName": "test-report.junit.xml"
    },
    "private": true,
    "packageManager": "yarn@4.12.0",
    "devDependencies": {
        "@babel/core": "^7.29.0",
        "@eslint/js": "9.39.2",
        "@jest/globals": "~30.5.2",
        "@react-native/jest-preset": "0.88.1",
        "@testing-library/react-native": "14.1.0",
        "@types/papaparse": "5.5.2",
        "@types/react": "~19.3.0",
        "@types/react-dom": "~19.3.0",
        "@types/react-native-web": "0.19.3",
        "cross-env": "10.1.0",
        "eslint": "9.39.2",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-jest": "29.17.1",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-sonarjs": "4.2.2",
        "eslint-plugin-testing-library": "7.16.2",
        "eslint-plugin-unused-imports": "4.4.1",
        "expo-mcp": "0.2.4",
        "jest": "~30.5.2",
        "jest-expo": "~58.0.16",
        "jest-junit": "17.0.0",
        "prettier": "3.10.1",
        "test-renderer": "1.3.1",
        "typescript": "~6.0.3",
        "typescript-eslint": "8.73.0"
    }
}
